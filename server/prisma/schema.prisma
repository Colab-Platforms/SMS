// Prisma Schema for Subscription Management System
// Translated from SQLite schema.sql + migrations to PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Theme {
  light
  dark
  system
}

enum Language {
  zh_CN @map("zh-CN")
  en
  ja
  ko
  fr
  de
  es
}

enum BillingCycle {
  monthly
  yearly
  quarterly
  semiannual
}

enum SubscriptionStatus {
  active
  trial
  cancelled
}

enum RenewalType {
  auto
  manual
}

enum PaymentStatus {
  succeeded
  failed
  refunded
}

enum UserRole {
  admin
  user
}

enum NotificationType {
  renewal_reminder
  expiration_warning
  renewal_success
  renewal_failure
  subscription_change
}

enum ChannelType {
  whatsapp
  email
}

enum NotificationStatus {
  sent
  failed
}

// ============================================================================
// MODELS
// ============================================================================

model Settings {
  id                     Int      @id @default(1)
  currency               String   @default("INR")
  theme                  Theme    @default(system)
  show_original_currency Boolean  @default(true)
  language               Language @default(zh_CN)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@map("settings")
}

model ExchangeRate {
  id            Int      @id @default(autoincrement())
  from_currency String
  to_currency   String
  rate          Decimal  @db.Decimal(15, 8)
  source        String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([from_currency, to_currency])
  @@map("exchange_rates")
}

model Category {
  id         Int      @id @default(autoincrement())
  value      String   @unique
  label      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions          Subscription[]
  monthlyCategorySummary MonthlyCategorySummary[]

  @@map("categories")
}

model PaymentMethod {
  id         Int      @id @default(autoincrement())
  value      String   @unique
  label      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions Subscription[]

  @@map("payment_methods")
}

model Subscription {
  id                Int                @id @default(autoincrement())
  name              String
  plan              String
  billing_cycle     BillingCycle
  next_billing_date DateTime?          @db.Date
  last_billing_date DateTime?          @db.Date
  amount            Decimal            @db.Decimal(10, 2)
  currency          String             @default("INR")
  payment_method_id Int
  start_date        DateTime?          @db.Date
  status            SubscriptionStatus @default(active)
  category_id       Int
  renewal_type      RenewalType        @default(manual)
  notes             String?
  website           String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  category            Category              @relation(fields: [category_id], references: [id])
  paymentMethod       PaymentMethod         @relation(fields: [payment_method_id], references: [id])
  paymentHistory      PaymentHistory[]
  notificationHistory NotificationHistory[]

  @@map("subscriptions")
}

model PaymentHistory {
  id                   Int           @id @default(autoincrement())
  subscription_id      Int
  payment_date         DateTime      @db.Date
  amount_paid          Decimal       @db.Decimal(10, 2)
  currency             String
  billing_period_start DateTime      @db.Date
  billing_period_end   DateTime      @db.Date
  status               PaymentStatus @default(succeeded)
  notes                String?
  created_at           DateTime      @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@map("payment_history")
}

model MonthlyCategorySummary {
  year                          Int
  month                         Int
  category_id                   Int
  total_amount_in_base_currency Decimal  @default(0.00) @db.Decimal(12, 2)
  base_currency                 String   @default("INR")
  transactions_count            Int      @default(0)
  updated_at                    DateTime @updatedAt

  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([year, month, category_id])
  @@map("monthly_category_summary")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password_hash String
  role          UserRole  @default(admin)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("users")
}

// ============================================================================
// NOTIFICATION SYSTEM (from migration_002)
// ============================================================================

model NotificationSetting {
  id                    Int              @id @default(autoincrement())
  notification_type     NotificationType @unique
  is_enabled            Boolean          @default(true)
  advance_days          Int?             @default(7)
  repeat_notification   Boolean          @default(false)
  notification_channels String           @default("[\"telegram\"]")
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  @@map("notification_settings")
}

model NotificationChannel {
  id             Int         @id @default(autoincrement())
  channel_type   ChannelType @unique
  channel_config String
  is_active      Boolean     @default(true)
  last_used_at   DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@map("notification_channels")
}

model NotificationHistory {
  id                Int                @id @default(autoincrement())
  subscription_id   Int
  notification_type String
  channel_type      String
  status            NotificationStatus
  recipient         String
  message_content   String
  error_message     String?
  sent_at           DateTime?
  created_at        DateTime           @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@map("notification_history")
}

model SchedulerSettings {
  id                      Int      @id @default(1)
  notification_check_time String   @default("09:00")
  timezone                String   @default("Asia/Shanghai")
  is_enabled              Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@map("scheduler_settings")
}
