# Production Environment Configuration
# Copy this file to .env and update with your values

# ==================== REQUIRED CONFIGURATION ====================
# PostgreSQL connection string (NeonDB or any Postgres instance) used by Prisma
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Administrator account used for server access
ADMIN_USERNAME=admin
# Provide either ADMIN_PASSWORD (for initial bootstrap) or ADMIN_PASSWORD_HASH (preferred)
# ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=


# ==================== BASIC CONFIGURATION ====================
# Uncomment and modify only if you need to override defaults

# Server port (default: 3001)
# PORT=3001

# Base currency for the system (default: INR)
# Supported: USD, EUR, GBP, CNY, JPY, CAD, AUD, TRY, HKD, INR
# BASE_CURRENCY=INR


# ==================== EXCHANGE RATE CONFIGURATION ====================
# Live rates are fetched daily from Frankfurter (frankfurter.dev) — no API key required.


# ==================== NOTIFICATION SYSTEM ====================
# WasenderAPI API Key (required for WhatsApp notifications)
# Connect your WhatsApp number by scanning the QR code on your WasenderAPI dashboard: https://wasenderapi.com
# WASENDER_API_KEY=your_wasender_api_key_here

# Email configuration (optional, required for email notifications)
# Sent via Resend's HTTPS API (not SMTP, which many hosts block outbound) — https://resend.com
# EMAIL_FROM must be on a domain you've verified with Resend (or use their onboarding@resend.dev sandbox address)
# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_FROM=Subscription Manager <no-reply@example.com>
# EMAIL_LOCALE=en

# NOTIFICATION_DEFAULT_CHANNELS=["whatsapp"]
# NOTIFICATION_DEFAULT_LANGUAGE=en
# SCHEDULER_TIMEZONE=UTC
# SCHEDULER_CHECK_TIME=09:00
# NOTIFICATION_DEFAULT_ADVANCE_DAYS=7
# NOTIFICATION_DEFAULT_REPEAT_NOTIFICATION=false
